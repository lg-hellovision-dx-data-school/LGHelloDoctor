[
  {
    "id": "SP-0067",
    "text": "응급실 좀 빨리 알려줘 큰일났어",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0188",
    "text": "안녕 또 보세",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0102",
    "text": "약 양 좀 줄여 먹어도 되능교",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0194",
    "text": "화면 크게 좀 해줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0112",
    "text": "심장약 빠뜨렸는데 어떡하지",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0122",
    "text": "할미가 숨을 못 쉬어 119 불러야 되나",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0014",
    "text": "영감이 변비가 심해서 며칠째 못 봐",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0003",
    "text": "할미가 요새 가슴이 답답해서 그래유",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0065",
    "text": "야간 진료 하는 디 있어유",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0045",
    "text": "우리 동네 안과 어디 있나 알려줘봐",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0137",
    "text": "영감이 119 부르라고 해 빨리",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0171",
    "text": "알겠습니다 고마워유",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0129",
    "text": "갑자기 시야가 깜깜해졌어 어떡하지",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0077",
    "text": "일반 외과 가까운 디 좀",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0159",
    "text": "갑자기 숨이 차고 가슴이 답답해 못 견디겠어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0168",
    "text": "이게 무슨 앱이여",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0046",
    "text": "영감이 갈 만한 정형외과 추천 좀 해줘유",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0131",
    "text": "우리 영감이 경련을 하고 있어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0031",
    "text": "영감이 가슴이 답답하다고 하는데 큰일인가",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0004",
    "text": "내 우리 손주가 자꾸 토하는데 무슨 병이여",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0160",
    "text": "손주가 약을 한 통 다 먹었어 어떡해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0016",
    "text": "허리가 디게 결려서 일어나기도 힘들구만",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0043",
    "text": "노친네 모시고 갈 내과가 어디여",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0127",
    "text": "손주가 머리를 다쳤는데 피가 안 멈춰",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0187",
    "text": "듣기 좋게 천천히 말해줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0163",
    "text": "이거 어떻게 쓰는 거여",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0048",
    "text": "지금 문 연 약국 어디 있어",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0111",
    "text": "두통약 자꾸 먹어도 괜찮은가유",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0006",
    "text": "어이쿠 어깨가 안 돌아가네 50견인가",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0195",
    "text": "다시 처음부터 알려줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0038",
    "text": "어지럽고 토할 것 같은데 무슨 병이여",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0123",
    "text": "우리 손주가 입에서 거품을 물고 있어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0013",
    "text": "무릎이 시큰거리고 계단을 못 내려가겠네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0037",
    "text": "자꾸 헛구역질이 나서 영 그렇네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0154",
    "text": "갑자기 말을 어눌하게 해 119",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0070",
    "text": "우리 영감 모시고 갈 신경과 어디 있나",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0062",
    "text": "동네 병원 어디 있는지 알려쥬",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0196",
    "text": "영감이 알려준 디 잘 안 되네",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0033",
    "text": "손이 저리고 감각이 좀 이상해유",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0173",
    "text": "글씨가 작아서 안 보여 크게 해줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0172",
    "text": "안녕히 계세유",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0061",
    "text": "지금 영업하는 병원 좀 찾아줘",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0011",
    "text": "발이 자꾸 부어서 신발이 안 들어가",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0145",
    "text": "손주가 잘못 먹어서 토하고 의식이 없어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0161",
    "text": "안녕하세유",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0053",
    "text": "가까운 이비인후과 어디 있나",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0126",
    "text": "노친네가 의식이 없어 빨리 좀",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0107",
    "text": "영감 진통제 한 알 더 먹여도 되능가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0074",
    "text": "가까운 비뇨기과 알려주소",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0114",
    "text": "약 먹고 운전해도 되능가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0106",
    "text": "감기약 효과가 없는데 더 먹어도 되능교",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0096",
    "text": "혈압약 며칠 안 먹어도 되능교",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0104",
    "text": "한약이랑 양약 같이 먹어도 되나",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0146",
    "text": "노친네가 갑자기 한쪽이 마비됐어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0044",
    "text": "응급실 어디로 가야 빠르나",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0001",
    "text": "오메 무릎이 디게 시리네유 어디 가야 되나",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0162",
    "text": "고맙구만 잘 들었어",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0193",
    "text": "음성으로 말하는 거 어떻게 해",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0017",
    "text": "며칠째 잠이 안 와서 영 힘드네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0081",
    "text": "이 약 먹어도 되능가 부작용 있을까봐",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0103",
    "text": "처방전 없이 살 수 있는 약인가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0039",
    "text": "살이 자꾸 빠져서 걱정이여",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0157",
    "text": "머리에서 피가 안 멈춰 빨리 와줘",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0177",
    "text": "영감이 쓰라고 해서 깔았어",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0136",
    "text": "갑자기 한쪽이 안 움직여요",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0079",
    "text": "아이고 병원 좀 빨리 찾아줘",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0116",
    "text": "우리 손주 어린이 약 용량 좀 알려줘",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0020",
    "text": "눈이 자꾸 침침해지는데 어디 가야 해",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0015",
    "text": "손주가 열이 많이 나는데 어쩌면 좋아",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0178",
    "text": "인사하고 싶어서 들어왔어",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0147",
    "text": "머리를 부딪쳤는데 정신이 가물가물해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0180",
    "text": "아이고 잘 됐네 고마워",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0066",
    "text": "가까운 가정의학과 알려주소",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0085",
    "text": "감기약은 식전 식후 언제 먹는 거여",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0166",
    "text": "다시 말해줘 못 들었어",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0047",
    "text": "가까운 한의원 좀 찾아줄래",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0105",
    "text": "약을 같이 먹으면 안 되는 게 뭐여",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0080",
    "text": "진료 보는 디 가까운 곳",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0055",
    "text": "산부인과 좀 알려쥬",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0197",
    "text": "이거 어떻게 끄는 거여",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0086",
    "text": "영감이 약을 두 개 먹었는데 괜찮은가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0119",
    "text": "진통제 두 알 먹어도 되능가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0110",
    "text": "알레르기약이랑 같이 먹는 약",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0134",
    "text": "손주가 갑자기 의식을 잃었어 빨리",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0143",
    "text": "갑자기 다리에 힘이 빠져 못 일어나",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0034",
    "text": "발이 차갑고 자꾸 시려서 못 견디겠네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0019",
    "text": "무릎이 부어서 영 못 걷겠어요",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0141",
    "text": "손주가 높은 디서 떨어졌어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0124",
    "text": "갑자기 한쪽 팔에 힘이 안 들어가 어쩌지",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0176",
    "text": "잘 모르겠어 도와줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0064",
    "text": "피부과 어디 있나 모르겠네",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0084",
    "text": "진통제 먹어도 괜찮을랑가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0149",
    "text": "갑자기 호흡곤란이 와서 못 견디겠어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0101",
    "text": "부작용 있는데 계속 먹어도 되능가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0156",
    "text": "가슴 통증이랑 식은땀이 같이 와",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0073",
    "text": "24시간 응급실 어디 있나",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0028",
    "text": "손주가 배가 아파서 자꾸 우는데",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0185",
    "text": "어떻게 쓰는지 모르겠네",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0113",
    "text": "처방받은 약을 다 못 먹었어 어쩌지",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0052",
    "text": "큰 병원이 어디 있는지 알려주소",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0175",
    "text": "다시 한번 알려쥬",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0005",
    "text": "엉덩이가 욱씬거리는데 정형외과 가야 되나",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0030",
    "text": "무릎이 펴지질 않아서 못 일어나겠어",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0184",
    "text": "손주야 이거 좀 봐줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0100",
    "text": "우리 영감 약 처방 좀 봐줘",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0099",
    "text": "감기약이랑 진통제 같이 먹어도 돼",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0132",
    "text": "갑자기 가슴이 짓눌리듯이 아파유",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0125",
    "text": "영감이 가슴을 쥐어짜듯이 아프다고 해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0199",
    "text": "고마워 또 봐",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0135",
    "text": "입술이 시퍼렇게 됐어 어떡해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0179",
    "text": "이거 어디 눌러야 되는 거여",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0121",
    "text": "워매 영감이 갑자기 쓰러졌어요 어떡해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0035",
    "text": "며칠째 두통이 가시질 않아 어쩌지",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0049",
    "text": "병원 좀 알려쥬 가까운 디",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0170",
    "text": "음성으로도 되능가",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0139",
    "text": "가슴이 너무 아파서 숨을 못 쉬겠어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0150",
    "text": "할미 발작이 시작됐어 어떡해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0133",
    "text": "할범이 토를 했는데 피가 섞여있어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0128",
    "text": "영감이 말을 못 하고 침을 흘려",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0022",
    "text": "입맛이 영 없어서 뭘 먹질 못해유",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0082",
    "text": "타이레놀이랑 혈압약 같이 먹어도 되나",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0078",
    "text": "종합병원 가는 길 좀 알려쥬",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0010",
    "text": "워매 손이 저려서 일을 못해",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0083",
    "text": "혈압약 빼먹었는데 한 번에 두 알 먹어도 되능교",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0165",
    "text": "어이고 잘 알았네",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0120",
    "text": "새로 받은 약이랑 같이 먹어도 되나",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0090",
    "text": "처방받은 약을 빼먹어도 되능가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0069",
    "text": "한의원 어디 있는지 좀 봐줘",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0054",
    "text": "치과 좀 찾아주소 가까운 디로",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0091",
    "text": "진통제는 하루에 몇 번 먹는 거여",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0095",
    "text": "손주가 어른 약 먹어도 되능가",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0042",
    "text": "아이고 병원 좀 찾아 줘봐 가까운 디로",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0094",
    "text": "아스피린 먹어도 되능가 위 약한디",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0117",
    "text": "영감이 약을 잘못 먹었는데 어떡해",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0200",
    "text": "잘 알겠다 그만 말해",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0158",
    "text": "영감이 갑자기 정신을 잃었어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0026",
    "text": "다리에 쥐가 자꾸 나서 잠을 못 자네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0181",
    "text": "그래 고마워 잘 들었네",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0148",
    "text": "영감이 가슴이 너무 아프다고 식은땀 흘려",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0075",
    "text": "손주 갈 만한 소아청소년과",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0059",
    "text": "우리 며느리 갈 산부인과 좀",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0153",
    "text": "영감이 화상을 크게 입었어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0018",
    "text": "자꾸 가슴이 답답하고 숨이 차여",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0050",
    "text": "손주 데려갈 소아과 어디 있나",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0093",
    "text": "노친네가 약 두 알 먹었는데 괜찮을까",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0076",
    "text": "동네 의원 어디 있는지 알려줘봐",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0142",
    "text": "영감이 자꾸 헛소리를 해",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0021",
    "text": "귀가 잘 안 들려서 답답해 죽겠네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0097",
    "text": "약 먹은 지 얼마 안 됐는데 또 먹어도 되나",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0032",
    "text": "머리가 띵하고 어지러운데 그냥 약 먹으면 되나",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0138",
    "text": "할미가 약 잘못 먹은 것 같애",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0118",
    "text": "항생제는 다 먹어야 하는 거여",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0012",
    "text": "가슴이 좀 답답한데 무슨 병원 가야 하나유",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0068",
    "text": "새벽에 갈 만한 병원 어디 있나",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0089",
    "text": "이 약 먹고 술 먹어도 되나유",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0092",
    "text": "약 먹는 시간을 놓쳐서 어쩌나",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0025",
    "text": "발바닥이 화끈거려서 못 견디겠다",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0098",
    "text": "위장약 식전에 먹어야 되는 거여",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0183",
    "text": "또 물어봐도 되능가",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0191",
    "text": "시간 좀 알려줘",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0087",
    "text": "당뇨약이랑 같이 먹으면 안 되는 약 있어유",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0182",
    "text": "도움 많이 받았다 고마워",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0040",
    "text": "노친네가 기침을 자꾸 해서 그래",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0169",
    "text": "손주가 깔아준 건디 어떻게 쓰는 거지",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0088",
    "text": "항생제 부작용이 어떤 거 있나",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0186",
    "text": "이 앱이 뭐 하는 거여",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0041",
    "text": "근처에 정형외과 어디 있는지 알려쥬",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0002",
    "text": "아이고 허리가 자꾸 욱신거려서 잠을 못 자",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0072",
    "text": "병원 위치 좀 봐줘유",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0151",
    "text": "의식이 흐려지는데 119 불러야 하나",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0115",
    "text": "위약 식전에 먹는 게 맞능교",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0057",
    "text": "영감이 다친 디 갈 외과가 어디여",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0108",
    "text": "약 먹는 거 잊어버렸는디 어쩌지",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0192",
    "text": "오늘 날씨가 어떠한가",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0167",
    "text": "워매 도움 많이 됐어유",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0051",
    "text": "응급실 가까운 데가 어디여",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0144",
    "text": "영감이 입에서 피를 토했어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0198",
    "text": "글씨가 영 안 보여",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0155",
    "text": "노친네가 쓰러져서 깨어나질 않아",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0130",
    "text": "며느리가 호흡이 가빠졌어 큰일났어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0060",
    "text": "가까운 응급실 위치 알려줘",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0056",
    "text": "정형외과 의원 어디 있는지 알아봐줘",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0024",
    "text": "손이 떨려서 글씨도 못 쓰겠어",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0008",
    "text": "다리가 저려서 걷기가 영 고통스럽네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0009",
    "text": "에휴 노친네가 자꾸 어지럽다고 하는데",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0109",
    "text": "이 약은 식후 몇 분에 먹는 거여",
    "label": "medication_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0152",
    "text": "손주가 알레르기로 목이 부어",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0023",
    "text": "잠을 자도 자도 피곤하구만",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0140",
    "text": "갑자기 한쪽 눈이 안 보여",
    "label": "emergency",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0174",
    "text": "화면이 이상한디 어떻게 해",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0027",
    "text": "허리가 끊어질 듯이 아프네 아파",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0189",
    "text": "알겠어 잘 들었어",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0036",
    "text": "변이 좀 까매서 걱정인디",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0058",
    "text": "안과 가까운 디 좀 알려주소",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0063",
    "text": "큰 종합병원 가까운 디 어디여",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0071",
    "text": "가까운 신경외과 좀 알려주소",
    "label": "hospital_search",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0190",
    "text": "인사 좀 받고 가",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0007",
    "text": "요 며칠 머리가 띵해유 어떡하지",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0029",
    "text": "이놈의 어깨가 도통 낫질 않네",
    "label": "symptom_inquiry",
    "source": "synthetic_senior_v1"
  },
  {
    "id": "SP-0164",
    "text": "고마워 도움이 됐다",
    "label": "general_chat",
    "source": "synthetic_senior_v1"
  }
]