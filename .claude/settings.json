{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start.sh"
          }
        ]
      },
      {
      
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[하네스] Bash 실행 전 검사 중...' && if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '(rm -rf|drop table|DELETE FROM|force-push)'; then echo '[차단] 위험 명령어 감지됨' && exit 1; fi"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[하네스] 파일 쓰기 전 — 경로 확인 중...'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '(FORBIDDEN_WORDS|EMERGENCY_KEYWORDS|EMERGENCY_SCORES|MEDICAL_CORRECTIONS|EMERGENCY_CASES)'; then echo '⚠️  [HITL] 의료/법률 자문 영역 수정 감지'; echo '    EMERGENCY_*  → 의사(응급의학) 검수 필요'; echo '    FORBIDDEN_*  → 법률·컴플라이언스 검수 필요'; echo '    MEDICAL_CORRECTIONS → 의사(일반의) 검수 필요'; echo '    PR 머지 전 체크리스트 확인: docs/HITL_3TIER.md'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[하네스] 파일 편집 완료 — backend/main.py 수정 시 pytest 실행 권장'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[하네스] 파일 생성 완료'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(docker compose*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "deny": []
  }
}
